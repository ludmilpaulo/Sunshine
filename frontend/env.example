# API Base URL
NEXT_PUBLIC_API_BASE_URL=https://sunshinebar.pythonanywhere.com/api

# Print Bridge URL
# For local development: http://localhost:3333
# For production: http://SEU_IP_LOCAL:3333 or http://SEU_SERVIDOR:3333
# Example: http://192.168.1.100:3333
NEXT_PUBLIC_PRINT_BRIDGE_URL=http://localhost:3333

# Printer Configuration (optional - can be set via Print Bridge .env)
# For LAN printer:
NEXT_PUBLIC_PRINTER_LAN_IP=
NEXT_PUBLIC_PRINTER_LAN_PORT=9100

# For USB printer:
NEXT_PUBLIC_PRINTER_USB_NAME=

